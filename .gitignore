# Generated project output: a regrade run writes thousands of AviSynth
# scripts, JSON colour reports, screenshots and LUTs under REGRADES/.
REGRADES/

# datMatcher is a separate project and is not vendored here. Drop its
# executables (or a whole checkout) into utils/datMatcher/ and datRegrade finds
# them automatically; everything there is ignored so it never gets committed.
utils/datMatcher/

# The legacy uppercase UTILS/ directory held vendored copies of datMatcher,
# LUTify and mixLUT; all of it is superseded and must never be committed.
UTILS/

# Generated batch/shell files
*.bat
*.sh
!examples/*.sh
!examples/*.bat

# Generated LUT and analysis artefacts
*.cube
!LUTS/*.cube
*_histogram.json
*_colors.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Editor / OS cruft
.vs/
.vscode/
*.user
.DS_Store
Thumbs.db

# Backups
*.bak
*.orig
